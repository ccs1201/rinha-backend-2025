### Windows
datasource-CLASS-NAME=org.postgresql.Driver
datasource-maximum-pool-size=15
datasource-MINIMUM-IDLE=10
datasource-PASSWORD=rinha
datasource-TIMEOUT=5000
datasource-URL=jdbc:postgresql://ccs-vbox:5432/rinha
datasource-USERNAME=rinha
payment-processor-default-url=http://ccs-vbox:8001
payment-processor-fallback-url=http://ccs-vbox:8002
server-port=9999
thread-pool-size=10
thread-queue-size= 30000
warmup=true
warmup_rounds= 5000

